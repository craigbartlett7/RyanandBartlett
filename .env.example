# --- Site ---
# Your live domain, no trailing slash. Used for canonical URLs, sitemap and schema.
NEXT_PUBLIC_SITE_URL=https://www.ryanandbartlett.co.uk

# --- Contact details shown on the site (leave blank to hide) ---
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
