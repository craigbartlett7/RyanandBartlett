NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_OPENING_HOURS=Mon-Fri 9am-6pm, Sat 9am-4pm

# --- Compliance details shown in the footer (leave blank to hide until you have them) ---
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_NUMBER=
NEXT_PUBLIC_REDRESS_SCHEME=
NEXT_PUBLIC_ICO_NUMBER=

# --- Supabase (server only, never expose the service role key) ---
SUPABASE_URL=
